# From browser: DevTools → Application → Cookies → leetcode.com
LEETCODE_SESSION=your_session_value_here
LEETCODE_CSRF=your_csrf_value_here
# AI provider keys (set the one for --model you use)
GEMINI_API_KEY=your_gemini_api_key_here
HUGGINGFACE_API_KEY=your_hf_token_here   # for --model hf
NVIDIA_API_KEY=your_nvidia_key_here       # for --model nvidia (build.nvidia.com)
GROQ_API_KEY=your_groq_key_here       # for --model groq
